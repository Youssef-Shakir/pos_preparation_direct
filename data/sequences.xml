<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sequence_preparation_ticket" model="ir.sequence">
        <field name="name">Preparation Ticket Number</field>
        <field name="code">pos.preparation.job.ticket</field>
        <field name="prefix"></field>
        <field name="suffix"></field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <!-- Cron: auto-retry failed print jobs (runs every minute, printer settings control actual interval) -->
    <record id="cron_retry_failed_print_jobs" model="ir.cron">
        <field name="name">POS Preparation: Retry Failed Print Jobs</field>
        <field name="model_id" ref="model_pos_preparation_job"/>
        <field name="state">code</field>
        <field name="code">model.action_retry_failed_jobs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <!-- Cron: clean up old printed jobs (runs daily) -->
    <record id="cron_cleanup_old_print_jobs" model="ir.cron">
        <field name="name">POS Preparation: Clean Up Old Print Jobs</field>
        <field name="model_id" ref="model_pos_preparation_job"/>
        <field name="state">code</field>
        <field name="code">model.cleanup_old_jobs(days=7)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
